#!/usr/bin/env bash
# zao-skills-sync - sync hand-written Claude Code skills between the live config
# (~/.claude/skills/) and the tracked repo (~/dev/zao-claude-skills/skills/).
#
# Usage:
#   zao-skills-sync push [<skill>]      - copy live -> repo (commit/push is manual)
#   zao-skills-sync pull [<skill>]      - copy repo -> live
#   zao-skills-sync diff [<skill>]      - show diff (live vs repo) per skill
#   zao-skills-sync list                - list every skill in the repo + whether it differs from live
#
# Without <skill>, operates on EVERY skill in the tracked-list (see TRACKED below).
#
# Tracked-list = hand-written skills only. Vendored-via-git skills (e.g. gstack)
# are excluded; install them from their own upstream repos.

set -uo pipefail

REPO_DIR="$HOME/dev/zao-claude-skills"
LIVE_DIR="$HOME/.claude/skills"

# Tracked skills - the ones that go in the repo. Edit this list when adding/removing.
# (Auto-detected at first push: any dir in $LIVE_DIR without a .git/ subdir AND
# not on the EXCLUDE list.)
EXCLUDE=(
  "gstack"          # vendored from its own upstream repo
)

list_tracked() {
  for d in "$LIVE_DIR"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    # Skip if vendored (has .git)
    [ -d "$d/.git" ] && continue
    # Skip if in exclude list
    skip=0
    for x in "${EXCLUDE[@]}"; do
      [ "$name" = "$x" ] && skip=1 && break
    done
    [ $skip -eq 1 ] && continue
    echo "$name"
  done
}

cmd_push() {
  local target="${1:-}"
  local count=0
  if [ -n "$target" ]; then
    skills=("$target")
  else
    skills=()
    while IFS= read -r line; do skills+=("$line"); done < <(list_tracked)
  fi

  for s in "${skills[@]}"; do
    local src="$LIVE_DIR/$s"
    local dst="$REPO_DIR/skills/$s"
    if [ ! -d "$src" ]; then
      echo "[push] SKIP $s - not in $LIVE_DIR" >&2
      continue
    fi
    mkdir -p "$dst"
    rsync -a --delete --exclude='.git' --exclude='.DS_Store' --exclude='node_modules' --exclude='__pycache__' "$src/" "$dst/"
    echo "[push] OK  $s"
    count=$((count + 1))
  done
  echo "Pushed $count skill(s) to $REPO_DIR. Run: cd $REPO_DIR && git add -A && git status"
}

cmd_pull() {
  local target="${1:-}"
  local count=0
  if [ -n "$target" ]; then
    skills=("$target")
  else
    skills=()
    while IFS= read -r line; do skills+=("$line"); done < <(cd "$REPO_DIR/skills" && ls -d */ 2>/dev/null | sed 's:/$::')
  fi

  for s in "${skills[@]}"; do
    local src="$REPO_DIR/skills/$s"
    local dst="$LIVE_DIR/$s"
    if [ ! -d "$src" ]; then
      echo "[pull] SKIP $s - not in $REPO_DIR" >&2
      continue
    fi
    mkdir -p "$dst"
    rsync -a --delete --exclude='.DS_Store' "$src/" "$dst/"
    echo "[pull] OK  $s"
    count=$((count + 1))
  done
  echo "Pulled $count skill(s) into $LIVE_DIR."
}

cmd_diff() {
  local target="${1:-}"
  if [ -n "$target" ]; then
    skills=("$target")
  else
    skills=()
    while IFS= read -r line; do skills+=("$line"); done < <(list_tracked)
  fi

  local any_diff=0
  for s in "${skills[@]}"; do
    local live="$LIVE_DIR/$s"
    local repo="$REPO_DIR/skills/$s"
    if [ ! -d "$repo" ]; then
      echo "[diff] NEW $s (only in live)"
      any_diff=1
      continue
    fi
    if [ ! -d "$live" ]; then
      echo "[diff] GONE $s (only in repo)"
      any_diff=1
      continue
    fi
    if ! diff -rq --exclude='.git' --exclude='.DS_Store' "$live" "$repo" >/dev/null 2>&1; then
      echo "[diff] DIFF $s"
      diff -rq --exclude='.git' --exclude='.DS_Store' "$live" "$repo" 2>/dev/null | head -10 | sed 's/^/  /'
      any_diff=1
    fi
  done
  [ $any_diff -eq 0 ] && echo "All tracked skills are in sync."
}

cmd_list() {
  echo "Tracked skills (auto-detected from $LIVE_DIR, excluding vendored + excluded):"
  list_tracked | sed 's/^/  /'
  echo ""
  echo "Excluded: ${EXCLUDE[*]}"
}

MODE="${1:-}"
shift 2>/dev/null || true

case "$MODE" in
  push) cmd_push "${1:-}" ;;
  pull) cmd_pull "${1:-}" ;;
  diff) cmd_diff "${1:-}" ;;
  list) cmd_list ;;
  *)
    echo "usage: zao-skills-sync push|pull|diff|list [<skill>]" >&2
    exit 2
    ;;
esac
